# Copy this file to .env.local and fill it in (Windows PowerShell: copy .env.local.example .env.local).
# .env.local is ignored by Git: never commit it, it holds your AI key.
# Next.js only reads .env.local at startup: restart "npm run dev" after a change.

# Address of the Abricot API (backend: https://github.com/BloomingMadao/Abricot-Backend)
URL_API=http://localhost:8000

# true  = test data kept in memory, no backend needed (reset when the server restarts)
# false = the real backend at URL_API
USE_MOCK=false

# AI task creation ("IA" button of a project)
# false = no AI: the window creates the number of tasks you type, with default values
USE_IA=false

# API key of the AI provider (secret)
TOKEN_IA=

# Address of an OpenAI-compatible API (empty = OpenAI)
URL_IA=https://api.groq.com/openai/v1

# Model of this provider (required when URL_IA is set)
MODEL_IA=openai/gpt-oss-20b